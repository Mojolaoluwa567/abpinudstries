{
  "version": 8,
  "sources": {
    "osm": {
      "type": "raster",
      "tiles": ["https://a.tile.openstreetmap.org/{z}/{x}/{y}.png"],
      "tileSize": 256
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#ffffff"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "osm",
      "paint": {
        "fill-color": "#000000"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "osm",
      "paint": {
        "fill-color": "#008000"
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "osm",
      "paint": {
        "line-color": "#FFA500",
        "line-width": 2
      }
    }
  ]
}
